{
  "name": "marpup",
  "version": "1.0.0",
  "description": "A teacher-friendly Markdown presentation toolkit powered by Marp.",
  "scripts": {
    "dev": "marp --server ./slides",
    "build": "npm run build:html",
    "copy:assets": "node ./scripts/copy-slide-assets.mjs",
    "build:html": "marp --output ./dist && npm run copy:assets",
    "build:pdf": "marp --output ./dist --pdf",
    "build:pptx": "marp --output ./dist --pptx",
    "format": "prettier --write \"**/*.{js,mjs,cjs}\""
  },
  "keywords": [
    "marp",
    "markdown",
    "slides",
    "education",
    "teaching"
  ],
  "author": "Julien Borgeon",
  "license": "MIT",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "prettier": "^3.3.3"
  }
}
