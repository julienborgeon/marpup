  "Insère une définition pédagogique": {
    "scope": "markdown",
    "prefix": "!layout-definition",
    "body": [
      "<!-- _class: layout-definition default-bullets -->",
      "",
      "- ${1:Définition}",
      "- ${2:Exemple}",
      "- ${3:Exemple}",
      "",
      "$0",
    ],
    "description": "Marpup : Définition mise en valeur suivie de ses exemples",
  },

  "Insère une distinction pédagogique": {
    "scope": "markdown",
    "prefix": "!layout-distinction",
    "body": [
      "<!-- _class: layout-distinction text-md -->",
      "",
      "<div class=\"grid\">",
      "",
      "<div class=\"col\">",
      "",
      "- ${1:Premier concept}",
      "- ${2:Exemple}",
      "- ${3:Exemple}",
      "",
      "</div>",
      "",
      "<div class=\"col\">",
      "",
      "≠",
      "",
      "</div>",
      "",
      "<div class=\"col\">",
      "",
      "- ${4:Second concept}",
      "- ${5:Exemple}",
      "- ${6:Exemple}",
      "",
      "</div>",
      "",
      "</div>",
      "",
      "$0",
    ],
    "description": "Marpup : Deux concepts présentés côte à côte avec leurs exemples",
  },

