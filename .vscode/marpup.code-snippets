{
  "Crée un template": {
    "scope": "markdown",
    "prefix": "up-template",
    "body": [
      "---",
      "marp: true",
      "theme: marpup",
      "size: 16:9",
      "title: ${1:Titre}",
      "author: ${2:Auteur}",
      "paginate: true",
      "header: ${3:}",
      "footer: ${4:}",
      "---",
      "",
      "# ${1:Titre}",
      "",
      "${5:Sous-titre}",
      "",
      "---",
      "",
      "$0",
    ],
    "description": "Crée un nouveau diaporama MarpUp",
  },

  "Ajoute une slide": {
    "scope": "markdown",
    "prefix": "up-slide",
    "body": ["", "---", "", "## ${1:Titre}", "", "$0"],
    "description": "Ajoute une nouvelle slide",
  },

  "Insère un tableau": {
    "scope": "markdown",
    "prefix": "up-table",
    "body": [
      "| ${1:Colonne 1} | ${2:Colonne 2} |",
      "| --- | --- |",
      "| ${3:Valeur} | ${4:Valeur} |",
      "$0",
    ],
    "description": "Insère un tableau Markdown",
  },

  "Insère une image locale": {
    "scope": "markdown",
    "prefix": "up-image",
    "body": ["![${1:Description}](../assets/images/${2:image.jpg})$0"],
    "description": "Insère une image locale",
  },

  "Insère image à gauche": {
    "scope": "markdown",
    "prefix": "@image-gauche",
    "body": ["<!-- _class: image-gauche -->", ""],
    "description": "Insère une image à gauche",
  },

  "Insère image à droite": {
    "scope": "markdown",
    "prefix": "@image-droite",
    "body": ["<!-- _class: image-droite -->", ""],
    "description": "Insère une image à droite",
  },

  "Insère 2 images": {
    "scope": "markdown",
    "prefix": "@images-2",
    "body": ["<!-- _class: images-2 -->", ""],
    "description": "Insère 2 images en vis-à-vis",
  },

  "Insère 3 images": {
    "scope": "markdown",
    "prefix": "@images-3",
    "body": "<!-- _class: images-3 -->",
    "description": "Insère 3 images en vis-à-vis",
  },

  "Insère 4 images": {
    "scope": "markdown",
    "prefix": "@images-4",
    "body": "<!-- _class: images-4 -->",
    "description": "Insère 4 images sur 2 colonnes",
  },
}
